# crontab -e  (as the savant user). Times are the server's local time; set TZ.
CRON_TZ=America/New_York
# 4:40am: yesterday's service day is over (late trains finish by ~3:30am)
40 4 * * *  cd /opt/nycsavant && .venv/bin/python -m savant nightly >> logs/nightly.log 2>&1 && ./ops/deploy.sh >> logs/deploy.log 2>&1
# Sundays 3:10am: refresh the static schedule (pick changes, new service)
10 3 * * 0  cd /opt/nycsavant && .venv/bin/python -m savant static >> logs/static.log 2>&1
