# Free key: https://register.developer.obanyc.com/  (needed for buses only)
BUSTIME_KEY=
# Optional, avoids throttling on data.ny.gov: https://data.ny.gov/profile/edit/developer_settings
SOCRATA_APP_TOKEN=
# Where nightly builds go: gh-pages | cloudflare | rsync | none
DEPLOY_TARGET=none
# gh-pages: defaults to git@github.com:aliowji1/nycsavant.git with key ~/.ssh/nycsavant_deploy
GH_PAGES_REMOTE=
GH_PAGES_KEY=
RSYNC_DEST=
